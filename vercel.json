{
  "functions": {
    "api/golf-chat.js": {
      "maxDuration": 60,
      "includeFiles": "{rules.json,competition_rules.json,lib/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/golf-chat.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
